<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.pos_terminal_simulator.controller.DashboardController"
        spacing="20"
        style="-fx-background-color: #f5f7fa;">

    <padding>
        <Insets
                top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

    <!-- =========================================================
         HEADER
         ========================================================= -->
    <HBox
            alignment="TOP_LEFT"
            spacing="10">

        <!-- Left side -->
        <VBox
                spacing="5"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Dashboard"
                    style="-fx-font-size: 28px;
                       -fx-font-weight: bold;"/>

            <Label
                    text="POS Terminal Overview"
                    style="-fx-font-size: 14px;
                       -fx-text-fill: #666666;"/>

        </VBox>

        <!-- Right side -->
        <Button
                text="← Back"
                onAction="#navigateBack"
                prefWidth="90"
                prefHeight="25"/>

    </HBox>

    <Separator/>

    <!-- =========================================================
         STATUS CARDS - ROW 1
         ========================================================= -->

    <HBox
            spacing="15"
            fillHeight="true">

        <!-- TERMINAL STATUS -->

        <VBox
                HBox.hgrow="ALWAYS"
                minWidth="150"
                prefHeight="120"
                spacing="10"
                style="-fx-background-color: white;
                       -fx-background-radius: 8;
                       -fx-border-radius: 8;
                       -fx-border-color: #dddddd;
                       -fx-padding: 20;">

            <Label
                    text="Terminal Status"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #666666;"/>

            <Label
                    fx:id="terminalStatusLabel"
                    text="ONLINE"
                    style="-fx-font-size: 24px;
                           -fx-font-weight: bold;"/>

        </VBox>


        <!-- HEARTBEAT STATUS -->

        <VBox
                HBox.hgrow="ALWAYS"
                minWidth="150"
                prefHeight="120"
                spacing="10"
                style="-fx-background-color: white;
                       -fx-background-radius: 8;
                       -fx-border-radius: 8;
                       -fx-border-color: #dddddd;
                       -fx-padding: 20;">

            <Label
                    text="Heartbeat"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #666666;"/>

            <Label
                    fx:id="heartbeatStatusLabel"
                    text="ACTIVE"
                    style="-fx-font-size: 24px;
                           -fx-font-weight: bold;"/>

        </VBox>

    </HBox>


    <!-- =========================================================
         STATUS CARDS - ROW 2
         ========================================================= -->

    <HBox
            spacing="15"
            fillHeight="true">

        <!-- HEARTBEAT INTERVAL -->

        <VBox
                HBox.hgrow="ALWAYS"
                minWidth="150"
                prefHeight="120"
                spacing="10"
                style="-fx-background-color: white;
                       -fx-background-radius: 8;
                       -fx-border-radius: 8;
                       -fx-border-color: #dddddd;
                       -fx-padding: 20;">

            <Label
                    text="Heartbeat Interval"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #666666;"/>

            <Label
                    fx:id="heartbeatIntervalLabel"
                    text="--:--:--"
                    style="-fx-font-size: 24px;
                           -fx-font-weight: bold;"/>

        </VBox>


        <!-- TRANSACTION COUNT -->

        <VBox
                HBox.hgrow="ALWAYS"
                minWidth="150"
                prefHeight="120"
                spacing="10"
                style="-fx-background-color: white;
                       -fx-background-radius: 8;
                       -fx-border-radius: 8;
                       -fx-border-color: #dddddd;
                       -fx-padding: 20;">

            <Label
                    text="Transactions"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #666666;"/>

            <Label
                    fx:id="transactionCountLabel"
                    text="0"
                    style="-fx-font-size: 24px;
                           -fx-font-weight: bold;"/>

        </VBox>

    </HBox>

</VBox>