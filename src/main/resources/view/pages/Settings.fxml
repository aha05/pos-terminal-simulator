<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.pos_terminal_simulator.controller.SettingsController"
        fitToWidth="true"
        fitToHeight="false"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        pannable="true"
        style="-fx-background-color: #f5f7fa;">

    <content>

        <VBox
                spacing="20"
                fillWidth="true"
                style="-fx-background-color: #f5f7fa;">

            <padding>
                <Insets
                        top="25"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>


            <!-- =========================================================
                 HEADER
                 ========================================================= -->
            <HBox
                    alignment="TOP_LEFT"
                    spacing="10">

                <!-- Left side -->
                <VBox
                        spacing="5"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="Settings"
                            style="-fx-font-size: 28px;
                               -fx-font-weight: bold;"/>

                    <Label
                            text="Configure POS terminal and simulator settings"
                            style="-fx-font-size: 14px;
                               -fx-text-fill: #666666;"/>

                </VBox>

                <!-- Right side -->
                <Button
                        text="← Back"
                        onAction="#navigateBack"
                        prefWidth="90"
                        prefHeight="25"/>

            </HBox>

            <Separator/>


            <!-- =========================================================
                 HEARTBEAT SETTINGS
                 ========================================================= -->

            <VBox
                    spacing="15"
                    maxWidth="Infinity"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8;
                           -fx-border-radius: 8;
                           -fx-border-color: #dddddd;
                           -fx-padding: 20;">

                <Label
                        text="Heartbeat Settings"
                        style="-fx-font-size: 20px;
                               -fx-font-weight: bold;"/>

                <Label
                        text="Configure automatic POS heartbeat communication."
                        style="-fx-text-fill: #666666;"/>


                <!-- Automatic Heartbeat -->

                <VBox spacing="5">

                    <Label
                            text="Automatic Heartbeat"
                            style="-fx-font-weight: bold;"/>

                    <CheckBox
                            fx:id="autoHeartbeatCheckBox"
                            text="Enable automatic heartbeat"/>

                </VBox>


                <!-- Heartbeat Interval -->

                <VBox spacing="5">

                    <Label
                            text="Heartbeat Interval"
                            style="-fx-font-weight: bold;"/>

                    <HBox spacing="10">

                        <Spinner
                                fx:id="heartbeatIntervalSpinner"
                                prefWidth="120"
                                editable="true"/>

                        <Label
                                text="seconds"
                                style="-fx-padding: 8 0 0 0;"/>

                    </HBox>

                </VBox>


                <!-- Manual Heartbeat -->

                <VBox spacing="5">

                    <Label
                            text="Manual Heartbeat"
                            style="-fx-font-weight: bold;"/>

                    <Button
                            fx:id="sendHeartbeatButton"
                            text="Send Heartbeat Now"
                            prefWidth="160"
                            onAction="#sendHeartbeat"/>

                </VBox>

            </VBox>


            <!-- =========================================================
                 TERMINAL SETTINGS
                 ========================================================= -->

            <VBox
                    spacing="15"
                    maxWidth="Infinity"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8;
                           -fx-border-radius: 8;
                           -fx-border-color: #dddddd;
                           -fx-padding: 20;">

                <Label
                        text="Terminal Settings"
                        style="-fx-font-size: 20px;
                               -fx-font-weight: bold;"/>


                <!-- Terminal ID -->

                <VBox spacing="5">

                    <Label
                            text="Terminal ID"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="terminalIdField"
                            promptText="Terminal ID"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Merchant ID -->

                <VBox spacing="5">

                    <Label
                            text="Merchant ID"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="merchantIdField"
                            promptText="Merchant ID"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Serial Number -->

                <VBox spacing="5">

                    <Label
                            text="Serial Number"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="serialNumberField"
                            promptText="Serial Number"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Default Currency -->

                <VBox spacing="5">

                    <Label
                            text="Default Currency"
                            style="-fx-font-weight: bold;"/>

                    <ComboBox
                            fx:id="currencyComboBox"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Firmware Version -->

                <VBox spacing="5">

                    <Label
                            text="Firmware Version"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="firmwareVersion"
                            promptText="Firmware Version"
                            maxWidth="Infinity"/>

                </VBox>

            </VBox>


            <!-- =========================================================
                 CONNECTION SETTINGS
                 ========================================================= -->

            <VBox
                    spacing="15"
                    maxWidth="Infinity"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8;
                           -fx-border-radius: 8;
                           -fx-border-color: #dddddd;
                           -fx-padding: 20;">

                <Label
                        text="Connection Settings"
                        style="-fx-font-size: 20px;
                               -fx-font-weight: bold;"/>


                <!-- POS Management URL -->

                <VBox spacing="5">

                    <Label
                            text="POS Management URL"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="posManagementUrlField"
                            promptText="http://localhost:8080"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Switch Host -->

                <VBox spacing="5">

                    <Label
                            text="Switch Host"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="switchHostField"
                            promptText="127.0.0.1"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Switch Port -->

                <VBox spacing="5">

                    <Label
                            text="Switch Port"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="switchPortField"
                            promptText="5000"
                            maxWidth="Infinity"/>

                </VBox>


                <!-- Network Type -->

                <VBox spacing="5">

                    <Label
                            text="Network Type"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="networkType"
                            promptText="Network Type"
                            maxWidth="Infinity"/>

                </VBox>

            </VBox>


            <!-- =========================================================
                 ACTIONS
                 ========================================================= -->

            <HBox spacing="15">

                <Button
                        fx:id="saveButton"
                        text="Save Settings"
                        prefWidth="150"
                        prefHeight="40"
                        onAction="#saveSettings"/>

                <Button
                        fx:id="resetButton"
                        text="Reset"
                        prefWidth="120"
                        prefHeight="40"
                        onAction="#resetSettings"/>

            </HBox>


            <!-- =========================================================
                 STATUS
                 ========================================================= -->

            <Label
                    fx:id="statusLabel"
                    text=""
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #666666;"/>

        </VBox>

    </content>

</ScrollPane>