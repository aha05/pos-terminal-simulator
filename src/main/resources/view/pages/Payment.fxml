<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.pos_terminal_simulator.controller.PaymentController"
        fitToWidth="true"
        fitToHeight="false"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        pannable="true"
        style="-fx-background-color: #f5f7fa;">

    <content>

        <VBox
                spacing="20"
                style="-fx-background-color: #f5f7fa;">

            <padding>
                <Insets
                        top="25"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>


            <!-- =========================================================
                 HEADER
                 ========================================================= -->

            <HBox
                    alignment="TOP_LEFT"
                    spacing="10">

                <!-- Left side -->
                <VBox
                        spacing="5"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="Payment"
                            style="-fx-font-size: 28px;
                       -fx-font-weight: bold;"/>

                    <Label
                            text="Create and send an ISO 8583 payment request"
                            style="-fx-font-size: 14px;
                       -fx-text-fill: #666666;"/>

                </VBox>

                <!-- Right side -->
                <Button
                        text="← Back"
                        onAction="#navigateBack"
                        prefWidth="90"
                        prefHeight="25"/>

            </HBox>

            <Separator/>


            <!-- =========================================================
                 PAYMENT FORM
                 ========================================================= -->

            <VBox
                    spacing="15"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8;
                           -fx-border-radius: 8;
                           -fx-border-color: #dddddd;
                           -fx-padding: 25;">

                <Label
                        text="Payment Request"
                        style="-fx-font-size: 20px;
                               -fx-font-weight: bold;"/>


                <!-- =====================================================
                     TRANSACTION TYPE
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Transaction Type"
                            style="-fx-font-weight: bold;"/>

                    <ComboBox
                            fx:id="transactionTypeComboBox"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     AMOUNT
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Amount"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="amountField"
                            promptText="Enter amount"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     CURRENCY
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Currency"
                            style="-fx-font-weight: bold;"/>

                    <ComboBox
                            fx:id="currencyComboBox"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     PAN
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Card Number (PAN)"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="panField"
                            promptText="Enter card number"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     PROCESSING CODE
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Processing Code"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="processingCodeField"
                            text="000000"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     STAN
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="STAN"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="stanField"
                            promptText="Automatically generated"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     TERMINAL ID
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Terminal ID"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="terminalIdField"
                            editable="false"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <!-- =====================================================
                     MERCHANT ID
                     ===================================================== -->

                <VBox spacing="6">

                    <Label
                            text="Merchant ID"
                            style="-fx-font-weight: bold;"/>

                    <TextField
                            fx:id="merchantIdField"
                            editable="false"
                            maxWidth="Infinity"
                            prefHeight="35"/>

                </VBox>


                <Separator/>


                <!-- =====================================================
                     ACTION BUTTONS
                     ===================================================== -->

                <HBox spacing="15">

                    <Button
                            fx:id="sendPaymentButton"
                            text="Send Payment"
                            prefWidth="160"
                            prefHeight="40"
                            onAction="#processPayment"/>

                    <Button
                            fx:id="clearButton"
                            text="Clear"
                            prefWidth="120"
                            prefHeight="40"
                            onAction="#clearForm"/>

                </HBox>

            </VBox>


            <!-- =========================================================
                 RESPONSE
                 ========================================================= -->

            <VBox
                    spacing="10"
                    style="-fx-background-color: white;
                           -fx-background-radius: 8;
                           -fx-border-radius: 8;
                           -fx-border-color: #dddddd;
                           -fx-padding: 20;">

                <Label
                        text="Transaction Response"
                        style="-fx-font-size: 20px;
                               -fx-font-weight: bold;"/>

                <Label
                        fx:id="responseStatusLabel"
                        text="Waiting for transaction..."
                        style="-fx-font-size: 16px;"/>

                <Label
                        fx:id="responseMessageLabel"
                        text=""
                        wrapText="true"
                        style="-fx-font-size: 14px;
                               -fx-text-fill: #666666;"/>

            </VBox>

        </VBox>

    </content>

</ScrollPane>
